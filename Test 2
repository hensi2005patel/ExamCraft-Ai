            const selectSubject = document.getElementById('notesSubjectSelect');
            const cards = document.querySelectorAll('.note-card-item');
            const noMatch = document.getElementById('noNotesMatchState');

            const query = input.value.trim().toLowerCase();
            const selectedSubject = selectSubject.value;

            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            let matches = 0;
            cards.forEach(card => {
                const cardSubject = card.getAttribute('data-subject');
                const text = card.innerText.toLowerCase();
                const keywords = (card.getAttribute('data-keywords') || '').toLowerCase();

                const matchSubject = (selectedSubject === 'all' || cardSubject === selectedSubject);
                const matchQuery = (!query || text.includes(query) || keywords.includes(query));

                if (matchSubject && matchQuery) {
                    card.style.display = 'flex';
                    matches++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (matches === 0) {
                noMatch.classList.remove('hidden');
            } else {
                noMatch.classList.add('hidden');
            }
        }

        function clearNotesSearch() {
            playClickSound();
            const input = document.getElementById('primaryNotesSearch');
            input.value = '';
            applyNotesSearchFilter();
            input.focus();
        }

        function quickFillSearch(term) {
            playClickSound();
            const input = document.getElementById('primaryNotesSearch');
            input.value = term;
            applyNotesSearchFilter();
            input.focus();
        }

        // ================= SEARCH & SELECT FILTER ON "MODULES" =================
        function applyCombinedFilter() {
            const searchInput = document.getElementById('moduleSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            const subjectSelect = document.getElementById('subjectSelect');
            const cards = document.querySelectorAll('.note-card');
            const noResults = document.getElementById('noResultsState');

            const query = searchInput.value.trim().toLowerCase();
            const selectedSubject = subjectSelect.value;

            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            let visibleCount = 0;

            cards.forEach(card => {
                const cardSubject = card.getAttribute('data-subject');
                const cardKeywords = (card.getAttribute('data-keywords') || '').toLowerCase();
                const cardText = card.innerText.toLowerCase();

                const matchesSubject = (selectedSubject === 'all' || cardSubject === selectedSubject);
                const matchesSearch = (!query || cardText.includes(query) || cardKeywords.includes(query));

                if (matchesSubject && matchesSearch) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (visibleCount === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        }

        function clearSearch() {
            playClickSound();
            const searchInput = document.getElementById('moduleSearchInput');
            searchInput.value = '';
            applyCombinedFilter();
            searchInput.focus();
        }

        // ================= AUDIO SYNTHESIZER =================
        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
            return audioCtx;
        }

        function playWarpSound() {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                
                osc.type = "sine";
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.35);

                gain.gain.setValueAtTime(0.01, now);
                gain.gain.linearRampToValueAtTime(0.2, now + 0.05);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.4);
            } catch (e) {}
        }

        function playSuccessSound() {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;
                [659.25, 987.77].forEach((freq, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(freq, now + i * 0.1);
                    gain.gain.setValueAtTime(0, now + i * 0.1);
                    gain.gain.linearRampToValueAtTime(0.15, now + i * 0.1 + 0.02);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.1 + 0.3);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(now + i * 0.1);
                    osc.stop(now + i * 0.1 + 0.3);
                });
            } catch (e) {}
        }

        function playErrorSound() {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "sawtooth";
                osc.frequency.setValueAtTime(140, now);
                gain.gain.setValueAtTime(0.12, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.25);
            } catch (e) {}
        }

        function playAlarmChime() {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;
                [523.25, 659.25, 783.99].forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(freq, now + (idx * 0.12));
                    gain.gain.setValueAtTime(0, now + (idx * 0.12));
                    gain.gain.linearRampToValueAtTime(0.18, now + (idx * 0.12) + 0.02);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + (idx * 0.12) + 0.4);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(now + (idx * 0.12));
                    osc.stop(now + (idx * 0.12) + 0.45);
                });
            } catch (e) {}
        }

        function playClickSound() {
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "triangle";
                osc.frequency.setValueAtTime(800, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(400, ctx.currentTime + 0.05);
                gain.gain.setValueAtTime(0.08, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.05);
            } catch (e) {}
        }

        function showToast(title, msg) {
            const toast = document.getElementById('screenToast');
            document.getElementById('toastTitle').innerText = title;
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('hidden', 'opacity-0', 'translate-y-3');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-3');
                setTimeout(() => toast.classList.add('hidden'), 300);
            }, 3500);
        }

        function testAlertAndSound() {
            playAlarmChime();
            showToast("Audio Test", "Sound alert is working properly.");
            if ("Notification" in window && Notification.permission === "granted") {
                new Notification("BCA / IT Study Alert", { body: "Your study reminder is active!" });
            } else {
                requestNotificationPermission();
            }
        }

        // ================= REMINDER ENGINE =================
        let selectedStrategy = '25m';
        let studyReminders = JSON.parse(localStorage.getItem('examcraft_reminders') || '[]');
        let activeAlarmItem = null;

        function requestNotificationPermission() {
            if ("Notification" in window) {
                Notification.requestPermission().then(p => {
                    if (p === 'granted') {
                        document.getElementById('permBtn').innerText = "Alerts On";
                    }
                });
            }
        }

        function selectIntervalStrategy(strategy) {
            selectedStrategy = strategy;
            document.querySelectorAll('.strategy-btn').forEach(btn => {
                if (btn.getAttribute('data-strategy') === strategy) {
                    btn.className = "strategy-btn p-1.5 text-center rounded-lg border border-brandGreen bg-brandGreen/25 text-brandGreen text-xs font-bold transition cursor-pointer";
                } else {
                    btn.className = "strategy-btn p-1.5 text-center rounded-lg border opacity-60 text-xs font-semibold transition hover:opacity-100 cursor-pointer";
                }
            });
            document.getElementById('customTimeInputWrapper').classList.toggle('hidden', strategy !== 'custom');
        }

        function scheduleStudyReminder() {
            const topic = document.getElementById('remTopic').value.trim();
            const subject = document.getElementById('remSubject').value;
            if (!topic) return alert("Enter a topic or chapter!");

            let mins = selectedStrategy === '24h' ? 1440 : (selectedStrategy === 'custom' ? parseInt(document.getElementById('remMinutes').value || 30) : 25);
            const dueTime = new Date(Date.now() + mins * 60000);

            studyReminders.push({
                id: Date.now().toString(),
                topic, subject,
                dueTimestamp: dueTime.getTime(),
                dueString: dueTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            });

            saveAndRefresh();
            document.getElementById('remTopic').value = '';
            playSuccessSound();
            showToast("Saved", `Reminder set for ${dueTime.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}`);
        }

        function renderReminders() {
            const container = document.getElementById('reminderListContainer');
            const countEl = document.getElementById('queueCount');
            if (!countEl || !container) return;
            countEl.innerText = `${studyReminders.length} Alerts`;

            if (studyReminders.length === 0) {
                container.innerHTML = `<p class="text-xs opacity-50 italic py-6 text-center">No active alerts. Add a topic above to schedule your next revision.</p>`;
                return;
            }

            studyReminders.sort((a, b) => a.dueTimestamp - b.dueTimestamp);
            container.innerHTML = '';
            studyReminders.forEach(item => {
                const diffMins = Math.max(0, Math.ceil((item.dueTimestamp - Date.now()) / 60000));
                const div = document.createElement('div');
                div.className = "theme-card flex items-center justify-between p-2 rounded-lg border text-xs";
                div.innerHTML = `
                    <div>
                        <span class="font-bold text-xs">${item.topic}</span>
                        <span class="text-[10px] text-brandBlue font-bold ml-1.5">${item.subject}</span>
                        <p class="text-[10px] opacity-70 mt-0.5">Due: ${item.dueString} (${diffMins}m left)</p>
                    </div>
                    <button onclick="deleteReminder('${item.id}')" class="opacity-70 hover:text-rose-500 p-1 cursor-pointer"><i class="fa-regular fa-trash-can"></i></button>
                `;
                container.appendChild(div);
            });
        }

        function deleteReminder(id) {
            studyReminders = studyReminders.filter(r => r.id !== id);
            saveAndRefresh();
        }

        function clearAllReminders() {
            if (confirm("Clear all active study reminders?")) {
                studyReminders = [];
                saveAndRefresh();
            }
        }

        function saveAndRefresh() {
            localStorage.setItem('examcraft_reminders', JSON.stringify(studyReminders));
            renderReminders();
        }

        function checkDueReminders() {
            const now = Date.now();
            const due = studyReminders.filter(r => r.dueTimestamp <= now);
            if (due.length > 0) {
                const item = due[0];
                studyReminders = studyReminders.filter(r => r.id !== item.id);
                saveAndRefresh();
                triggerAlarm(item);
            }
        }

        function triggerAlarm(reminder) {
            activeAlarmItem = reminder;
            playAlarmChime();
            showToast(`Revise: ${reminder.topic}`, `Spend 5 mins on ${reminder.subject}.`);
            if ("Notification" in window && Notification.permission === "granted") {
                new Notification(`Recall: ${reminder.topic}`, { body: `Review ${reminder.subject} now!` });
            }
            document.getElementById('alarmTopicTitle').innerText = reminder.topic;
            document.getElementById('alarmSubjectSubtitle').innerText = reminder.subject;
            document.getElementById('reminderAlarmModal').classList.remove('hidden');
        }

        function closeAlarmModal() {
            document.getElementById('reminderAlarmModal').classList.add('hidden');
        }

        function snoozeCurrentAlarm(minutes) {
            if (!activeAlarmItem) return;
            const dueTime = new Date(Date.now() + minutes * 60000);
            activeAlarmItem.dueTimestamp = dueTime.getTime();
            activeAlarmItem.dueString = dueTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            studyReminders.push(activeAlarmItem);
            saveAndRefresh();
            closeAlarmModal();
        }

        window.addEventListener('DOMContentLoaded', () => {
            renderReminders();
            renderLoginHistory();
            setInterval(checkDueReminders, 10000);
            switchPage('page-login');
        });
    </script>
