        function generateUniversalAiAnswer(userQuery) {
            const q = userQuery.toLowerCase();
            
            if (q.includes('pointer') || q.includes('memory') || q.includes('malloc') || q.includes('c language')) {
                return `<strong>C Pointers & Dynamic Memory Management Breakdown:</strong><br>
                - A pointer is a variable that stores the memory address of another variable: <code>int x = 42; int *ptr = &x;</code><br>
                - Dynamic allocation is managed via heap functions: <code>malloc()</code> (uninitialized bytes), <code>calloc()</code> (zero-initialized blocks), and <code>free()</code> (memory deallocation).<br>
                <em>Exam Tip:</em> Always check if pointer allocation returns <code>NULL</code> before usage to secure full marks in coding questions!`;
            } 
            else if (q.includes('von neumann') || q.includes('architecture') || q.includes('register') || q.includes('coa')) {
                return `<strong>Von Neumann Architecture & Cycle:</strong><br>
                - Features a single shared memory structure for both data and program instructions.<br>
                - Core components include the Arithmetic Logic Unit (ALU), Control Unit (CU), Registers (PC, MAR, MBR, IR, Accumulator), and Buses.<br>
                - Follows the Fetch-Decode-Execute pipeline cycle.`;
            } 
            else if (q.includes('acid') || q.includes('database') || q.includes('normalization') || q.includes('sql') || q.includes('key')) {
                return `<strong>Database Management & SQL Concepts:</strong><br>
                - <strong>ACID:</strong> Atomicity, Consistency, Isolation, Durability ensure safe database transactions.<br>
                - <strong>Normalization:</strong> Eliminates redundancies and anomalies (1NF, 2NF, 3NF, BCNF).<br>
                - <strong>Keys:</strong> Primary Key (unique + non-null), Candidate Key, and Foreign Key (maintains referential integrity between tables).`;
            } 
            else if (q.includes('deadlock') || q.includes('process') || q.includes('thread') || q.includes('scheduling') || q.includes('banker')) {
                return `<strong>Operating Systems Core Concepts:</strong><br>
                - <strong>Process vs Thread:</strong> Processes are heavy independent units with separate memory spaces; threads are lightweight units sharing process resources.<br>
                - <strong>Deadlock Conditions:</strong> Mutual Exclusion, Hold & Wait, No Preemption, and Circular Wait.<br>
                - <strong>CPU Scheduling:</strong> Algorithms like FCFS, SJF, Priority, and Round Robin determine processor allocation efficiency.`;
            } 
            else if (q.includes('logic') || q.includes('truth table') || q.includes('tautology') || q.includes('discrete') || q.includes('math')) {
                return `<strong>Discrete Mathematics & Propositional Logic:</strong><br>
                - Propositions are declarative statements that are either True or False.<br>
                - Conditional equivalence: <code>p → q ≡ ¬p ∨ q</code>.<br>
                - A <em>Tautology</em> is a compound proposition that evaluates to True under all possible truth values.`;
            } 
            else if (q.includes('dom') || q.includes('http') || q.includes('html') || q.includes('css') || q.includes('get') || q.includes('post') || q.includes('web')) {
                return `<strong>Web Technologies & Protocols:</strong><br>
                - <strong>DOM (Document Object Model):</strong> Tree structure representing HTML elements for dynamic manipulation via JavaScript.<br>
                - <strong>HTTP Methods:</strong> <code>GET</code> retrieves data idempotently; <code>POST</code> submits data to create/modify resources on the server.`;
            } 
            else {
                return `Here is the precise and comprehensive answer to your question: <strong>"${userQuery}"</strong>.<br><br>
                1. <strong>Core Definition:</strong> In academic and technical contexts, this topic addresses fundamental principles, structural mechanisms, and applied standards.<br>
                2. <strong>Key Principles:</strong> Analyzed systematically through logical breakdown, parameters, and syntax rules.<br>
                3. <strong>Exam Application:</strong> When answering this in your university exams, structure your response with an introduction, key characteristics, diagrams/code snippets where applicable, and a summary conclusion for top marks.<br><br>
                <em>Pro Tip: Click the "API Key" button at the top of this chat tab to connect your live Google Gemini API key for real-time generative responses!</em>`;
            }
        }

