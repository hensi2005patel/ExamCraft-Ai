                    </div>
                `;
            }
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
            return divId;
        }

        async function sendUserChatMessage() {
            const input = document.getElementById('chatInputBox');
            const query = input.value.trim();
            if (!query) return;

            appendChatMessage('You', query, false);
            input.value = '';
            playClickSound();

            const sendBtn = document.getElementById('sendChatBtn');
            sendBtn.disabled = true;
            sendBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i>`;

            if (userGeminiApiKey) {
                const typingId = appendChatMessage('Gemini AI Assistant', 'Thinking...', true, true);
                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${userGeminiApiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{
                                parts: [{ text: "You are ExamCraft AI, an expert academic tutor for BCA and B.Sc (IT) college students. Answer this question comprehensively with clear bullet points and exam tips: " + query }]
                            }]
                        })
                    });
                    const data = await response.json();
                    const el = document.getElementById(typingId);
                    if (data && data.candidates && data.candidates[0].content.parts[0].text) {
                        const rawText = data.candidates[0].content.parts[0].text;
                        const formattedHtml = rawText.replace(/\n/g, '<br>');
                        el.querySelector('.ai-response-text').innerHTML = formattedHtml;
                        el.querySelector('.ai-response-text').classList.remove('ai-typing-cursor');
                    } else {
                        el.querySelector('.ai-response-text').innerHTML = "Error communicating with Gemini API. Please check your API key.";
                        el.querySelector('.ai-response-text').classList.remove('ai-typing-cursor');
                    }
                } catch(err) {
                    const el = document.getElementById(typingId);
                    el.querySelector('.ai-response-text').innerHTML = "Network connection error while reaching Gemini API.";
                    el.querySelector('.ai-response-text').classList.remove('ai-typing-cursor');
                }
                sendBtn.disabled = false;
                sendBtn.innerHTML = `<span>Ask AI</span> <i class="fa-solid fa-paper-plane text-[10px]"></i>`;
                playSuccessSound();
            } else {
                setTimeout(() => {
                    const aiReply = generateUniversalAiAnswer(query);
                    appendChatMessage('ExamCraft AI Assistant', aiReply, true);
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = `<span>Ask AI</span> <i class="fa-solid fa-paper-plane text-[10px]"></i>`;
                    playSuccessSound();
                }, 500);
            }
        }

