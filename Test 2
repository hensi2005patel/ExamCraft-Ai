                regBtn.className = "flex-1 py-2 text-xs font-bold rounded-lg transition opacity-75 hover:opacity-100 cursor-pointer";
            }
        }

        function recordLoginEvent(identifier, eventType) {
            const entry = {
                identifier,
                eventType,
                timestamp: new Date().toLocaleString(),
                ipInfo: "Local Web Client (Secure)"
            };
            loginHistory.unshift(entry);
            if (loginHistory.length > 50) loginHistory.pop();
            localStorage.setItem('examcraft_login_history', JSON.stringify(loginHistory));
            renderLoginHistory();
        }

        function renderLoginHistory() {
            const tbody = document.getElementById('loginHistoryTableBody');
            if (!tbody) return;

            if (loginHistory.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center italic opacity-60">No login history recorded yet.</td></tr>`;
                return;
            }

            tbody.innerHTML = '';
            loginHistory.forEach(item => {
                const tr = document.createElement('tr');
                const badgeColor = item.eventType === 'Registration' ? 'text-brandYellow bg-brandYellow/10 border-brandYellow/30' : 'text-brandGreen bg-brandGreen/10 border-brandGreen/30';
                tr.innerHTML = `
                    <td class="py-2.5 px-3 font-semibold">${item.identifier}</td>
                    <td class="py-2.5 px-3"><span class="text-[10px] font-bold px-2 py-0.5 rounded border ${badgeColor}">${item.eventType}</span></td>
                    <td class="py-2.5 px-3 opacity-80">${item.timestamp}</td>
                    <td class="py-2.5 px-3 font-mono opacity-70">${item.ipInfo}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function clearLoginHistory() {
            playClickSound();
            if (confirm("Clear all login history logs?")) {
                loginHistory = [];
                localStorage.removeItem('examcraft_login_history');
                renderLoginHistory();
                showToast("Cleared", "Login history logs wiped.");
